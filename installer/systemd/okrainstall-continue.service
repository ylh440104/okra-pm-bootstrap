[Unit]
Description=OKRAINSTALL continue (Base-OS stage 2 / Final-OS stage 3)
Documentation=file:///usr/lib/okrainstall
After=local-fs.target
# Do not wait for network-online or systemd-user-sessions. user-sessions is
# After=network.target, so the installer would stay invisible until DHCP
# finishes. Stage 2 waits for a default route itself.
Before=getty@tty1.service
ConditionPathExists=/usr/bin/okrainstall
ConditionPathExists=/var/lib/okrainstall/phase
Conflicts=getty@tty1.service okrainstall-live.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/okrainstall --continue
StandardInput=tty
StandardOutput=tty
StandardError=tty
# The same rule as the live unit: the console the kernel registered is the one
# someone is watching. Naming tty1 here failed every boot on a machine whose
# only terminal is the serial line - the unit could not open its terminal and
# exited before printing anything.
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
